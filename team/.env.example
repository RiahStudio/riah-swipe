# Copy to .env and edit. Real values never go in this file.

# Port to listen on.
PORT=8790

# The public address people use to reach this server (used in emailed links).
BASE_URL=http://localhost:8790

# Only set this if a reverse proxy serves the app under a sub-path, e.g. /swipe.
# BASE_PATH=

# Where the database and uploaded media live.
# DATA_DIR=./data

# Required. A long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: email for password resets and review notifications (via Resend).
# With no key set, the server just logs a notice and carries on.
# RESEND_API_KEY=
# MAIL_FROM=Riah Swipe <noreply@example.com>

# Optional: Google sign-in. All three must be set to turn it on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8790/api/auth/google/callback
